---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../lib/paths';
---

<BaseLayout title="Stránka nenalezena" noindex>
  <section class="shell shell--content notfound">
    <p class="label">404</p>
    <h1 class="notfound__title serif">Tahle stránka tu není.</h1>
    <p class="prose">
      Možná se přesunula, možná v odkazu chybí písmenko. Zkuste portfolio —
      tam se dá zabloudit líp.
    </p>
    <a class="cta" href={path('/portfolio/')}>
      Do portfolia
      <span class="cta__arrow" aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    padding-block: var(--section-gap);
  }

  .notfound__title {
    font-size: var(--t-h1);
    font-weight: 400;
    line-height: 1.05;
  }

  .notfound .cta { margin-top: var(--s-4); }
</style>
