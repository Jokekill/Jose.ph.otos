---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Let the first section run to the very top (used by the homepage hero). */
  flush?: boolean;
  /** Lay the header over a full-height hero instead of above it. */
  overlayHeader?: boolean;
}

const { flush = false, overlayHeader = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">Přeskočit na obsah</a>
    <Header overlay={overlayHeader} />
    <main id="main" class:list={['site-main', { 'site-main--flush': flush }]}>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Marks that JS is available, so the reveal animation only hides content
      // it can actually bring back. Inline + early to avoid a flash.
      document.documentElement.classList.add('js');
    </script>

    <script>
      // Progressive reveal for anything marked .reveal.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .site-main {
    flex: 1;
    padding-top: var(--section-gap);
  }

  .site-main--flush { padding-top: 0; }
</style>
